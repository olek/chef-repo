[Unit]
Description=Freeze userspace until user input
Documentation=man:systemctl(1)

[Service]
Type=exec
ExecStart=/usr/bin/systemd-inhibit --what=idle:sleep --who=catnap --why="Freeze userspace cgroup under catnap" /usr/local/sbin/catnap-watcher
TimeoutStopSec=5s
KillSignal=SIGTERM
Slice=system.slice
StandardOutput=journal
StandardError=journal
