#!/usr/bin/env bash
set -euo pipefail

# Repo directory setup
REPO_DIR=""
if [[ -d "$HOME/git/their/mattpocock-skills" ]]; then
    REPO_DIR="$HOME/git/their/mattpocock-skills"
elif [[ -d "/data/dev/git/other/mattpocock-skills" ]]; then
    REPO_DIR="/data/dev/git/other/mattpocock-skills"
elif [[ -d "/data/dev/misc/mattpocock-skills" ]]; then
    REPO_DIR="/data/dev/misc/mattpocock-skills"
fi

PREFIX=">>>"

if [[ -z "$REPO_DIR" ]]; then
    if [[ -d "$HOME/git/their" ]]; then
        REPO_DIR="$HOME/git/their/mattpocock-skills"
    elif [[ -d "/data/dev/git/other" ]]; then
        REPO_DIR="/data/dev/git/other/mattpocock-skills"
    elif [[ -d "/data/dev/misc" ]]; then
        REPO_DIR="/data/dev/misc/mattpocock-skills"
    elif [[ -d "/data/dev" ]]; then
        REPO_DIR="/data/dev/mattpocock-skills"
    elif [[ -d "$HOME/git" ]]; then
        REPO_DIR="$HOME/git/mattpocock-skills"
    else
        echo "ERROR: None of the expected parent directories (~/git/their, /data/dev/git/other, /data/dev/misc, /data/dev, ~/git) exist. Aborting clone." >&2
        exit 1
    fi
    echo "$PREFIX Repo directory not found, cloning from GitHub to $REPO_DIR..."
    mkdir -p "$(dirname "$REPO_DIR")"
    git clone https://github.com/mattpocock/skills.git "$REPO_DIR"
else
    echo "$PREFIX Pulling latest from repo at $REPO_DIR..."
    git -C "$REPO_DIR" pull --ff-only
fi

CANONICAL_DIR="$HOME/agent/skills/vendored/mattpocock"

TARGET_DIRS=(
    "$HOME/.claude/skills"
    "$HOME/.codex/skills"
    "$HOME/.gemini/config/skills"
)

SKILLS=(
    grill-with-docs
    grill-me
    tdd
    ubiquitous-language
    improve-codebase-architecture
    write-a-skill
    handoff
)

find_skill() {
    local name="$1"
    find "$REPO_DIR/skills" -maxdepth 2 -mindepth 2 -type d -name "$name" | head -1
}

sync_skill() {
    local name="$1"
    local src
    src="$(find_skill "$name")"

    if [[ -z "$src" ]]; then
        echo "$PREFIX $name: NOT FOUND in repo, skipping"
        return
    fi

    local dest="$CANONICAL_DIR/$name"

    if [[ ! -d "$dest" ]]; then
        mkdir -p "$dest"
        cp -pR "$src/." "$dest/"
        echo "$PREFIX $name: copied to $dest"
        return
    fi

    if diff -qr "$dest" "$src" &>/dev/null; then
        echo "$PREFIX $name: up to date in $dest"
    else
        echo "$PREFIX $name: updated in $dest"
        diff -rU0 "$dest" "$src" | grep -Ev '^(---|[+]{3}|@@|diff )' | sed $'s/^-\\(.*\\)/\033[31m-\\1\033[0m/;s/^+\\(.*\\)/\033[32m+\\1\033[0m/' || true
        echo ""
        rm -rf "$dest"
        mkdir -p "$dest"
        cp -pR "$src/." "$dest/"
    fi
}

link_skill() {
    local name="$1"
    local target_dir="$2"
    local src="$CANONICAL_DIR/$name"
    local dest="$target_dir/$name"

    if [[ -L "$dest" ]]; then
        if [[ "$(readlink -f "$dest")" == "$src" ]]; then
            echo "$PREFIX $name: linked to shared source in $target_dir"
            return
        fi
        echo "ERROR: $dest is a symlink to a different target. Resolve it before updating." >&2
        return 1
    fi

    if [[ -e "$dest" ]]; then
        echo "ERROR: $dest already exists and is not a symlink. Move it aside before updating." >&2
        return 1
    fi

    ln -s "$src" "$dest"
    echo "$PREFIX $name: linked in $target_dir"
}

echo ""

echo "$PREFIX Syncing upstream skills to $CANONICAL_DIR..."
mkdir -p "$CANONICAL_DIR"
for skill in "${SKILLS[@]}"; do
    sync_skill "$skill"
done
echo ""

for target_dir in "${TARGET_DIRS[@]}"; do
    echo "$PREFIX Linking shared skills in $target_dir..."
    mkdir -p "$target_dir"
    for skill in "${SKILLS[@]}"; do
        link_skill "$skill" "$target_dir"
    done
    echo ""
done
