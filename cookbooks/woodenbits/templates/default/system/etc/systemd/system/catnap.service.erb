[Unit]
Description=Freeze userspace until user input
Documentation=man:systemctl(1)

[Service]
Type=exec
# Run the watcher under systemd-inhibit to protect the frozen state:
#   --mode=block: Strictly blocks sleep transitions (the default mode for 'sleep' is only 'delay' up to 5s)
#   --what=idle:sleep:handle-suspend-key: Blocks system idle state, kernel sleep, and suspend key triggers
#   --who=catnap: Identifier of the inhibitor owner displayed in 'systemd-inhibit --list'
#   --why=...: Human-readable rationale recorded in systemd inhibitor logs
ExecStart=/usr/bin/systemd-inhibit --mode=block --what=idle:sleep:handle-suspend-key --who=catnap --why="Freeze userspace cgroup under catnap" /usr/local/sbin/catnap-watcher
TimeoutStopSec=5s
KillSignal=SIGTERM
Slice=system.slice
StandardOutput=append:/var/log/catnap/catnap.log
StandardError=append:/var/log/catnap/catnap.log
