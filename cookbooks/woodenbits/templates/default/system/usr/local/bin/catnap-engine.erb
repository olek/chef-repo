#!/usr/bin/env bash
#
# Core root-level execution engine for the catnap low-power userspace sleep suite.
#
# Invoked by: systemd system service 'catnap.service' under systemd-inhibit.
#
# Exists to provide an instant-wake alternative to ACPI hardware suspend. It orchestrates
# the full system quiescence lifecycle: blanking Mutter displays, setting CPU EPP to 'power',
# ensuring discrete GPU runtime D3 suspend, stopping GNOME Shell, and freezing all active
# user cgroup slices (user-*.slice). It monitors raw input events via libinput and thaws
# the system back to full performance upon user activity.
#
set -euo pipefail

detect-nvidia-gpu() {
    local dev=''

    for dev in /sys/bus/pci/devices/*; do
        if [[ -f "$dev/vendor" && "$(cat "$dev/vendor")" == '0x10de' &&
              -f "$dev/class" && "$(cat "$dev/class")" =~ ^0x03 ]]; then
            echo "$dev"

            return 0
        fi
    done

    # Return 0 even if not found to prevent 'set -e' from aborting on non-NVIDIA systems
    return 0
}

detect-speaker-device() {
    local line=''
    local card_num=''
    local card_id=''
    local device_num=''
    local device_desc=''

    # Pick the built-in analog output for the catnap chime: the first playback device that is
    # neither on a USB card (external DAC, webcam, audio interface) nor a digital output
    # (HDMI/SPDIF). Addresses the speaker by ALSA card *name* so it survives card renumbering.
    while IFS= read -r line; do
        [[ "$line" =~ ^card\ ([0-9]+):\ ([^\ ]+)\ \[.*\],\ device\ ([0-9]+):\ (.*)$ ]] || continue
        card_num="${BASH_REMATCH[1]}"
        card_id="${BASH_REMATCH[2]}"
        device_num="${BASH_REMATCH[3]}"
        device_desc="${BASH_REMATCH[4],,}"

        if [[ -e "/proc/asound/card${card_num}/usbid" ]]; then
            continue
        fi
        if [[ "$device_desc" == *hdmi* || "$device_desc" == *digital* ||
              "$device_desc" == *s/pdif* || "$device_desc" == *iec958* ]]; then
            continue
        fi

        printf 'plughw:CARD=%s,DEV=%s\n' "$card_id" "$device_num"

        return 0
    done < <(aplay -l 2>/dev/null)

    # Return 0 even if not found so 'set -e' does not abort; play-tone skips on empty device.
    return 0
}

readonly SETTLE_SECONDS=1
readonly SAMPLE_INTERVAL_SECONDS=60
readonly QUIESCENCE_TIMEOUT_SECONDS=60
readonly QUIESCENCE_INTERVAL_SECONDS=5
readonly WAKE_EVENT_PATTERN='KEYBOARD_KEY|POINTER_BUTTON|TOUCH_DOWN'
readonly NVIDIA_DEVICE=$(detect-nvidia-gpu)
readonly MUTTER_DESTINATION='org.gnome.Mutter.DisplayConfig'
readonly MUTTER_PATH='/org/gnome/Mutter/DisplayConfig'
readonly MUTTER_INTERFACE='org.gnome.Mutter.DisplayConfig'
readonly POWER_SAVE_ON=0
readonly POWER_SAVE_OFF=3
readonly LOG_DIR='/var/log/catnap'
# Built-in analog output (laptop speakers), auto-detected by ALSA card name. Driven directly
# via aplay to bypass PipeWire - which routes to the USB DAC by default and is frozen alongside
# userspace during catnap. Empty on hosts with no built-in analog card; play-tone then no-ops.
readonly SPEAKER_DEVICE=$(detect-speaker-device)
readonly SPEAKER_SAMPLE_RATE=44100

INITIAL_EPP=''
TELEMETRY_FILE=''
TELEMETRY_PID=''

log() {
    printf '%s %s\n' "$(date --iso-8601=seconds)" "$*"
}

get-cpu-epp() {
    local readonly first_policy='/sys/devices/system/cpu/cpufreq/policy0/energy_performance_preference'

    if [[ -f "$first_policy" ]]; then
        cat "$first_policy"
    fi
}

set-cpu-epp() {
    local readonly epp_mode="$1"
    local policy_file=''

    for policy_file in /sys/devices/system/cpu/cpufreq/policy[0-9]*/energy_performance_preference; do
        if [[ -f "$policy_file" ]]; then
            echo "$epp_mode" > "$policy_file" || true
        fi
    done
}

freeze-userspace() {
    local user_slice_dir=''
    local slice_name=''

    for user_slice_dir in /sys/fs/cgroup/user.slice/user-*.slice; do
        if [[ -d "$user_slice_dir" ]]; then
            slice_name=$(basename "$user_slice_dir")
            systemctl freeze "$slice_name" || true
        fi
    done
}

thaw-userspace() {
    local user_slice_dir=''
    local slice_name=''

    for user_slice_dir in /sys/fs/cgroup/user.slice/user-*.slice; do
        if [[ -d "$user_slice_dir" ]]; then
            slice_name=$(basename "$user_slice_dir")
            systemctl thaw "$slice_name" || true
        fi
    done
}

suspend-gnome-shell() {
    killall -9 gvfsd-trash 2>/dev/null || true
    killall -STOP gnome-shell 2>/dev/null || true
}

resume-gnome-shell() {
    killall -CONT gnome-shell 2>/dev/null || true
}

set-display-power-mode() {
    local readonly mode="$1"
    local user_dir=''
    local uid=''
    local username=''

    for user_dir in /run/user/*; do
        if [[ -d "$user_dir" ]]; then
            uid=$(basename "$user_dir")
            username=$(id -nu "$uid" 2>/dev/null || continue)
            runuser --user "$username" -- env \
                "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${uid}/bus" \
                busctl --user set-property "$MUTTER_DESTINATION" "$MUTTER_PATH" \
                "$MUTTER_INTERFACE" PowerSaveMode i "$mode" || true
        fi
    done
}

log-nvidia-quiescence-diagnostics() {
    local readonly stage_name="$1"
    local connector=''
    local power_file=''
    local node=''
    local line=''
    local dev_nodes=(/dev/nvidia*)

    log "--- [DIAGNOSTICS] NVIDIA Quiescence Failure at stage '${stage_name}' ---"

    if [[ -n "$NVIDIA_DEVICE" && -d "$NVIDIA_DEVICE" ]]; then
        log "PCI Power PM: status=$(read-file "${NVIDIA_DEVICE}/power/runtime_status"), usage=$(read-file "${NVIDIA_DEVICE}/power/runtime_usage"), control=$(read-file "${NVIDIA_DEVICE}/power/control"), active_kids=$(read-file "${NVIDIA_DEVICE}/power/runtime_active_kids")"
        for node in "${NVIDIA_DEVICE}/drm"/*; do
            if [[ -e "/dev/dri/$(basename "$node")" ]]; then
                dev_nodes+=("/dev/dri/$(basename "$node")")
            fi
        done
    fi

    for power_file in /proc/driver/nvidia/gpus/*/power; do
        if [[ -f "$power_file" ]]; then
            log "Driver Power Info ($(basename "$(dirname "$power_file")")):"
            while IFS= read -r line; do
                [[ -n "$line" ]] && log "  $line"
            done < "$power_file"
        fi
    done

    log "DRM Connectors:"
    for connector in /sys/class/drm/card[0-9]-*; do
        if [[ -d "$connector" ]]; then
            log "  $(basename "$connector"): status=$(read-file "$connector/status"), enabled=$(read-file "$connector/enabled"), dpms=$(read-file "$connector/dpms")"
        fi
    done

    if command -v nvidia-smi >/dev/null 2>&1; then
        log "nvidia-smi summary:"
        while IFS= read -r line; do
            [[ -n "$line" ]] && log "  $line"
        done < <(nvidia-smi --query-gpu=name,display_active,pstate,power.draw,utilization.gpu --format=csv 2>/dev/null || true)
    fi

    if command -v fuser >/dev/null 2>&1; then
        log "Open GPU device handles (fuser):"
        while IFS= read -r line; do
            [[ -n "$line" ]] && log "  $line"
        done < <(fuser -v "${dev_nodes[@]}" 2>&1 || true)
    fi

    log "--- [END DIAGNOSTICS] ---"
}

wait-for-nvidia-quiescence() {
    local readonly stage_name="${1:-quiesce}"
    local elapsed=0
    local status=''
    local usage=''

    if [[ -z "$NVIDIA_DEVICE" || ! -f "${NVIDIA_DEVICE}/power/runtime_status" ]]; then
        log "No NVIDIA GPU found; skipping GPU quiescence wait (${stage_name})."

        return 0
    fi

    log "Waiting for NVIDIA GPU to enter suspended state at '${stage_name}' (up to ${QUIESCENCE_TIMEOUT_SECONDS}s)..."
    while (( elapsed < QUIESCENCE_TIMEOUT_SECONDS )); do
        status=$(read-file "${NVIDIA_DEVICE}/power/runtime_status")
        usage=$(read-file "${NVIDIA_DEVICE}/power/runtime_usage")

        if [[ "$status" == 'suspended' || "$usage" == '0' ]]; then
            log "NVIDIA GPU quiesced at stage '${stage_name}' after ${elapsed}s (status: ${status}, usage: ${usage})."

            return 0
        fi

        sleep "$QUIESCENCE_INTERVAL_SECONDS"
        elapsed=$((elapsed + QUIESCENCE_INTERVAL_SECONDS))
    done

    status=$(read-file "${NVIDIA_DEVICE}/power/runtime_status")
    usage=$(read-file "${NVIDIA_DEVICE}/power/runtime_usage")
    log "ERROR: Timed out at stage '${stage_name}' after ${QUIESCENCE_TIMEOUT_SECONDS}s (status: ${status}, usage: ${usage})."
    log-nvidia-quiescence-diagnostics "$stage_name"

    return 1
}

reset-screensaver() {
    local user_dir=''
    local uid=''
    local username=''

    for user_dir in /run/user/*; do
        if [[ -d "$user_dir" ]]; then
            uid=$(basename "$user_dir")
            username=$(id -nu "$uid" 2>/dev/null || continue)
            runuser --user "$username" -- env \
                "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${uid}/bus" \
                busctl --user call org.gnome.ScreenSaver /org/gnome/ScreenSaver org.gnome.ScreenSaver SetActive b false >/dev/null 2>&1 || true
            runuser --user "$username" -- env \
                "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${uid}/bus" \
                busctl --user set-property org.gnome.SessionManager /org/gnome/SessionManager/Presence org.gnome.SessionManager.Presence status u 0 >/dev/null 2>&1 || true
        fi
    done
}

play-tone() {
    local readonly frequency_hz="$1"
    local readonly duration_ms="$2"

    if [[ -z "$SPEAKER_DEVICE" ]]; then
        return 0
    fi

    # Synthesize a short raw PCM sine (with 5ms fades to avoid clicks) and feed it straight
    # to the laptop speakers. Best-effort: capped by 'timeout' and never fails the caller so
    # the suspend lifecycle is unaffected if the device is busy or absent.
    LC_ALL=C awk \
        -v frequency="$frequency_hz" \
        -v duration_ms="$duration_ms" \
        -v rate="$SPEAKER_SAMPLE_RATE" \
        'BEGIN {
            samples = int(rate * duration_ms / 1000)
            fade = int(rate * 0.005)
            for (i = 0; i < samples; i++) {
                envelope = 1
                if (i < fade) { envelope = i / fade }
                if (i > samples - fade) { envelope = (samples - i) / fade }
                sample = int(envelope * 9000 * sin(2 * 3.14159265 * frequency * i / rate))
                low = sample % 256; if (low < 0) { low += 256 }
                high = int(sample / 256) % 256; if (high < 0) { high += 256 }
                printf "%c%c", low, high
            }
        }' \
        | timeout 10 aplay -q -D "$SPEAKER_DEVICE" -f S16_LE -r "$SPEAKER_SAMPLE_RATE" -c 1 2>/dev/null || true
}

# Rising major arpeggio: catnap reached full quiescence and is entering the frozen sleep.
play-catnap-entered() {
    play-tone 523 120
    play-tone 659 120
    play-tone 784 200
}

# Descending low tones: catnap aborted because the NVIDIA GPU refused to suspend.
play-catnap-aborted() {
    play-tone 440 200
    play-tone 311 200
    play-tone 208 350
}

notify-users() {
    local readonly summary="$1"
    local user_dir=''
    local uid=''
    local username=''

    for user_dir in /run/user/*; do
        if [[ -d "$user_dir" ]]; then
            uid=$(basename "$user_dir")
            username=$(id -nu "$uid" 2>/dev/null || continue)
            sudo -u "$username" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${uid}/bus" \
                notify-send --app-name=catnap --icon=weather-clear-night --urgency=normal \
                'Catnap finished' "$summary" 2>/dev/null || true
        fi
    done
}

read-file() {
    local readonly path="$1"
    local readonly fallback="${2:-unavailable}"

    cat "$path" 2>/dev/null || printf '%s\n' "$fallback"
}

read-hwmon-temperature() {
    local readonly device_name="$1"
    local readonly temperature_file="$2"
    local hwmon=''

    for hwmon in /sys/class/hwmon/hwmon*; do
        if [[ "$(read-file "$hwmon/name")" == "$device_name" ]]; then
            read-file "$hwmon/$temperature_file"

            return
        fi
    done

    printf 'unavailable\n'
}

sample-telemetry() {
    printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
        "$(date --iso-8601=seconds)" \
        "$(read-file /sys/fs/cgroup/user.slice/cpu.stat | awk '$1 == "usage_usec" { print $2 }')" \
        "$(read-file /sys/fs/cgroup/system.slice/cpu.stat | awk '$1 == "usage_usec" { print $2 }')" \
        "$(read-file /sys/class/powercap/intel-rapl:0/energy_uj)" \
        "$(read-file /sys/class/powercap/intel-rapl:1/energy_uj)" \
        "$(read-file /sys/class/power_supply/BAT0/status)" \
        "$(read-file /sys/class/power_supply/BAT0/energy_now)" \
        "$(read-hwmon-temperature coretemp temp1_input)" \
        "$(read-hwmon-temperature nvme temp1_input)" \
        "$(read-hwmon-temperature iwlwifi_1 temp1_input)" \
        "$(read-file "${NVIDIA_DEVICE}/power/runtime_status")" \
        "$(read-file "${NVIDIA_DEVICE}/power/runtime_active_time")" \
        "$(read-file "${NVIDIA_DEVICE}/power/runtime_suspended_time")" \
        >> "$TELEMETRY_FILE"
}

collect-telemetry() {
    printf '%s\n' 'timestamp,user_cpu_usec,system_cpu_usec,package_energy_uj,psys_energy_uj,battery_status,battery_energy_uwh,cpu_package_temp_mc,nvme_temp_mc,wifi_temp_mc,nvidia_runtime_status,nvidia_active_ms,nvidia_suspended_ms' \
        > "$TELEMETRY_FILE"

    while true; do
        sample-telemetry
        sleep "$SAMPLE_INTERVAL_SECONDS"
    done
}

start-telemetry() {
    local readonly run_id="$1"

    install --directory --owner=root --group=root --mode=0755 "$LOG_DIR"
    TELEMETRY_FILE="${LOG_DIR}/${run_id}-samples.csv"
    log "Writing passive telemetry: $TELEMETRY_FILE"
    collect-telemetry &
    TELEMETRY_PID="$!"
}

stop-telemetry() {
    if [[ -n "$TELEMETRY_PID" ]]; then
        kill "$TELEMETRY_PID" 2>/dev/null || true
        wait "$TELEMETRY_PID" 2>/dev/null || true
        sample-telemetry
        log "Wrote passive telemetry: $TELEMETRY_FILE"
        TELEMETRY_PID=''
    fi
}

print-and-save-summary() {
    local -n telemetry="$1"
    local readonly elapsed_seconds=$((telemetry[after_epoch] - telemetry[before_epoch]))
    local readonly timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local summary="Finished ${elapsed_seconds}s catnap at ${timestamp}"
    local details=''

    if [[ "${telemetry[before_cpu]:-}" =~ ^[0-9]+$ && "${telemetry[after_cpu]:-}" =~ ^[0-9]+$ ]]; then
        details+=$(printf 'user CPU: %.3fs' "$((telemetry[after_cpu] - telemetry[before_cpu]))e-6")
    fi

    if [[ "${telemetry[before_battery_status]:-}" == 'Discharging' &&
          "${telemetry[after_battery_status]:-}" == 'Discharging' &&
          "${telemetry[before_energy]:-}" =~ ^[0-9]+$ && "${telemetry[after_energy]:-}" =~ ^[0-9]+$ &&
          "$elapsed_seconds" -gt 0 ]]; then
        local readonly battery_stats=$(awk \
            -v energy_uwh="$((telemetry[before_energy] - telemetry[after_energy]))" \
            -v seconds="$elapsed_seconds" \
            'BEGIN { printf "%.2fW (%.3fWh used)", (energy_uwh * 0.0036 / seconds), (energy_uwh / 1000000) }')
        if [[ -n "$details" ]]; then
            details+=', '
        fi
        details+="energy rate: ${battery_stats}"
    fi

    if [[ "${telemetry[before_nvidia_active]:-}" =~ ^[0-9]+$ && "${telemetry[after_nvidia_active]:-}" =~ ^[0-9]+$ &&
          "${telemetry[before_nvidia_suspended]:-}" =~ ^[0-9]+$ && "${telemetry[after_nvidia_suspended]:-}" =~ ^[0-9]+$ ]]; then
        local readonly active_diff=$((telemetry[after_nvidia_active] - telemetry[before_nvidia_active]))
        local readonly suspended_diff=$((telemetry[after_nvidia_suspended] - telemetry[before_nvidia_suspended]))
        local readonly total_diff=$((active_diff + suspended_diff))
        if (( total_diff > 0 )); then
            local readonly suspended_rate=$(awk \
                -v active="$active_diff" \
                -v suspended="$suspended_diff" \
                'BEGIN { printf "%.1f", (suspended * 100) / (active + suspended) }')
            if [[ -n "$details" ]]; then
                details+=', '
            fi
            details+="NVIDIA suspended rate: ${suspended_rate}%"
        fi
    fi

    if [[ -n "$details" ]]; then
        summary+=" (${details})"
    fi

    log "$summary"
    printf '%s\n' "$summary" > "${LOG_DIR}/last-summary.txt"
    notify-users "$summary"
}

wait-for-input() {
    local readonly accept_after=$((SECONDS + SETTLE_SECONDS))
    local event=''

    while IFS= read -r event; do
        if (( SECONDS >= accept_after )) && [[ "$event" =~ $WAKE_EVENT_PATTERN ]]; then
            return 0
        fi
    done < <(stdbuf --output=L libinput debug-events)

    log "ERROR: libinput stopped before detecting wake input." >&2

    return 1
}

main() {
    local readonly run_id=$(date '+%Y%m%d-%H%M%S')
    declare -A stats=()

    INITIAL_EPP=$(get-cpu-epp)

    trap 'thaw-userspace; resume-gnome-shell || true; sleep 1; set-display-power-mode "$POWER_SAVE_ON" || true; reset-screensaver || true; if [[ -n "${INITIAL_EPP:-}" ]]; then set-cpu-epp "$INITIAL_EPP" || true; fi; stop-telemetry' EXIT
    trap 'exit 0' INT TERM HUP

    start-telemetry "$run_id"

    stats[before_epoch]=$(date +%s)
    stats[before_cpu]=$(awk '$1 == "usage_usec" { print $2 }' /sys/fs/cgroup/user.slice/cpu.stat 2>/dev/null || true)
    stats[before_energy]=$(cat /sys/class/power_supply/BAT*/energy_now 2>/dev/null || true)
    stats[before_battery_status]=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null || true)

    if [[ -n "$NVIDIA_DEVICE" && -f "${NVIDIA_DEVICE}/power/runtime_active_time" ]]; then
        stats[before_nvidia_active]=$(cat "${NVIDIA_DEVICE}/power/runtime_active_time" 2>/dev/null || true)
        stats[before_nvidia_suspended]=$(cat "${NVIDIA_DEVICE}/power/runtime_suspended_time" 2>/dev/null || true)
    fi

    set-cpu-epp power
    set-display-power-mode "$POWER_SAVE_OFF"
    wait-for-nvidia-quiescence "pre-gnome-shell" || true
    suspend-gnome-shell
    if ! wait-for-nvidia-quiescence "post-gnome-shell"; then
        play-catnap-aborted
        exit 1
    fi
    freeze-userspace
    play-catnap-entered
    wait-for-input

    thaw-userspace
    resume-gnome-shell
    sleep 1
    set-display-power-mode "$POWER_SAVE_ON"
    reset-screensaver
    if [[ -n "${INITIAL_EPP:-}" ]]; then
        set-cpu-epp "$INITIAL_EPP"
    fi
    stop-telemetry

    stats[after_epoch]=$(date +%s)
    stats[after_cpu]=$(awk '$1 == "usage_usec" { print $2 }' /sys/fs/cgroup/user.slice/cpu.stat 2>/dev/null || true)
    stats[after_energy]=$(cat /sys/class/power_supply/BAT*/energy_now 2>/dev/null || true)
    stats[after_battery_status]=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null || true)

    if [[ -n "$NVIDIA_DEVICE" && -f "${NVIDIA_DEVICE}/power/runtime_active_time" ]]; then
        stats[after_nvidia_active]=$(cat "${NVIDIA_DEVICE}/power/runtime_active_time" 2>/dev/null || true)
        stats[after_nvidia_suspended]=$(cat "${NVIDIA_DEVICE}/power/runtime_suspended_time" 2>/dev/null || true)
    fi

    # Reset trap before normal exit to avoid running EXIT cleanup twice
    trap - EXIT
    print-and-save-summary stats
}

main "$@"
