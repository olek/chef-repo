engine = "whisper"

[hotkey]
enabled = true
key = "SCROLLLOCK"          # push-to-talk key
mode = "push_to_talk"

[audio]
device = "default"
sample_rate = 16000
max_duration_secs = 60

[whisper]
model = "large-v3-turbo"
language = "en"
# GOTCHA: this template is deployed identically to every machine, but the right
# value is host-dependent. If another workstation has a different GPU layout
# (single GPU, or the discrete card at a different Vulkan index), 1 will be wrong
# there. Make this username-conditional (like ~/.tmuxstart/general) if that ever bites.
gpu_device = 1              # [machine-specific] NVIDIA = Vulkan device 1 (discrete GPU on dual-GPU system)
initial_prompt = "GUS, Claude, Codanna, Serena, ast-grep, Feathers, Fowler, common-gateway, admin-api, e360-whatsapp, e360-messaging-runtime-libs, uacp-shared-libraries"
gpu_isolation = true
on_demand_loading = false
# Upstream default is false. This was set to true when the template was expanded
# to cover every available option (deployed Jul 21 2026, alongside the 0.7.1 ->
# 0.7.5 upgrade), not because it was wanted. FA is exact attention in theory but
# not bit-identical: different accumulation order, FP16 accumulation on some
# backends. large-v3-turbo has only 4 decoder layers and is the family's most
# repetition-loop-prone model, and the Vulkan FA kernels are the least
# battle-tested. Suspected cause of a transcription-quality regression; leave off.
flash_attention = false
eager_processing = false
# Pinned explicitly rather than left to the default: 0.7.5's CLI exposes
# --no-whisper-context-optimization (a negative flag, implying default ON), while
# the shipped /etc template says it is disabled by default and warns of repetition
# loops on large-v3/turbo. The sources conflict, so state it and don't depend on
# which one is right.
context_window_optimization = false
mode = "local"
translate = false

[audio.feedback]
enabled = false             # Warning: enabling this keeps a PipeWire playback stream open constantly when idle, preventing the CPU from scaling down to its minimum frequency
theme = "subtle"            # "default" is louder (needs volume ≤0.1); "mechanical" is clicky
volume = 0.3

[output]
mode = "type"
fallback_to_clipboard = true
type_delay_ms = 0
auto_submit = false
shift_enter_newlines = true
pre_type_delay_ms = 0

[output.notification]
on_recording_start = true
on_recording_stop = true
on_transcription = false    # disabled — clutters screen with repeated text
show_engine_icon = false

[text]
spoken_punctuation = true
smart_auto_submit = false

[text.replacements]
"vox type" = "voxtype"
"grill me skill" = "/grill-me skill"
"grill with docs skill" = "/grill-with-docs skill"
"refactor feathers skill" = "/refactor-feathers skill"
"refactor fowler skill" = "/refactor-fowler skill"

[meeting]
enabled = false

[meeting.diarization]
enabled = false

[meeting.audio]
source = "mic"

[osd]
enabled = false
frontend = "gtk4"
position = "bottom-center"
width_px = 400
height_px = 48
margin_px = 24
top_margin = 0.85
opacity = 0.95
waveform_window_secs = 3.0
peak_decay_db_per_sec = 6.0
waveform_gain = 10.0

[status]
icon_theme = "emoji"
