" NOTE: root never gets this file -- user-config.rb deletes root's ~/.gvimrc
" and skips rendering. So this template only ever serves full-config users.

" set the X11 font to use
" set guifont=-misc-fixed-medium-r-normal--14-130-75-75-c-70-iso8859-1

set mousehide		" Hide the mouse when typing text

" for Ubuntu, GTK2 GUI
"set gfn=Monospace\ 11
"set guifont=Ubuntu\ Mono\ Regular\ 12
set guifont=Liberation\ Mono\ 11

" Resizing fonts on the fly
let s:pattern = '^\(.* \)\([1-9][0-9]*\)$'
let s:minfontsize = 6
let s:maxfontsize = 16
function! AdjustFontSize(amount)
  if has("gui_gtk2") && has("gui_running")
    let fontname = substitute(&guifont, s:pattern, '\1', '')
    let cursize = substitute(&guifont, s:pattern, '\2', '')
    let newsize = cursize + a:amount
    if (newsize >= s:minfontsize) && (newsize <= s:maxfontsize)
      let newfont = fontname . newsize
      let &guifont = newfont
    endif
  else
    echoerr "You need to run the GTK2 version of Vim to use this function."
  endif
endfunction

function! LargerFont()
  call AdjustFontSize(1)
endfunction
command! LargerFont call LargerFont()

function! SmallerFont()
  call AdjustFontSize(-1)
endfunction
command! SmallerFont call SmallerFont()

" Font plus / minus
nnoremap <silent> <leader>fp :LargerFont<CR>
nnoremap <silent> <leader>fm :SmallerFont<CR>

" set the gui options to:
"   g: grey inactive menu items
"   m: display menu bar
"   r: display scrollbar on right side of window
"   b: display scrollbar at bottom of window
"   t: enable tearoff menus on Win32
"   T: enable toolbar on Win32
set guioptions-=m  "remove menu bar
set guioptions-=T  "remove toolbar
set guioptions-=r  "remove right-hand scroll bar

" selected light themes followed by the dark themes on separate line for easier management
silent SetColors
  \ vc minimal lingodirector sienna smpl stackoverflow winter morning bclear chela_light grape habiLight highlighter_term kyle nedit newsprint pleasant summerfruit blueshift
  \ slate 1989 colorsbox-material darktango deus earendel ekinivim moria nefertiti seattle tango-desert void zenburn anotherdark brighton codedark darkZ ecostation feral flattown ghostbuster japanesque lilypink materialtheme mrpink nord obsidian2 parsec Tomorrow-Night-Eighties softblue termschool DimGrey bubblegum corn

" default theme
colorscheme flattown

highlight WhiteSpaceEOL ctermbg=darkgreen guibg=lightgreen
match WhiteSpaceEOL /^\s\+\t\+\|^\t\+\s\+\|\s\+$/

" Tab headings & Navigation
" Go to the last active tab, like ctrl-^ but for tabs
augroup gvimrc_tab
  autocmd!
  autocmd TabLeave * let g:lasttab = tabpagenr()
augroup END

nnoremap <silent> <C-Tab> :exe "tabn ".g:lasttab<CR>
vnoremap <silent> <C-Tab> :exe "tabn ".g:lasttab<CR>

" Move the current tab left/right, browser-style, with Ctrl-Shift-PageUp/Down.
" Plain Ctrl-PageUp/Down still just switch tabs (Vim's default).
" Wrap around: :tabmove 0 sends it to the front, $ to the end.
function! MoveTabLeft()
  if tabpagenr() == 1
    tabmove $
  else
    tabmove -1
  endif
endfunction

function! MoveTabRight()
  if tabpagenr() == tabpagenr('$')
    tabmove 0
  else
    tabmove +1
  endif
endfunction

nnoremap <silent> <C-S-PageUp> :call MoveTabLeft()<CR>
inoremap <silent> <C-S-PageUp> <Esc>:call MoveTabLeft()<CR>
nnoremap <silent> <C-S-PageDown> :call MoveTabRight()<CR>
inoremap <silent> <C-S-PageDown> <Esc>:call MoveTabRight()<CR>

" Jump directly to tab N with Alt-#
" Janus-inspired; Olek switched the original Ctrl to Alt
nnoremap <A-0> 0gt
inoremap <A-0> <Esc>0gt
nnoremap <A-1> 1gt
inoremap <A-1> <Esc>1gt
nnoremap <A-2> 2gt
inoremap <A-2> <Esc>2gt
nnoremap <A-3> 3gt
inoremap <A-3> <Esc>3gt
nnoremap <A-4> 4gt
inoremap <A-4> <Esc>4gt
nnoremap <A-5> 5gt
inoremap <A-5> <Esc>5gt
nnoremap <A-6> 6gt
inoremap <A-6> <Esc>6gt
nnoremap <A-7> 7gt
inoremap <A-7> <Esc>7gt
nnoremap <A-8> 8gt
inoremap <A-8> <Esc>8gt
nnoremap <A-9> 9gt
inoremap <A-9> <Esc>9gt

function! GuiTabLabel()
  let label = ''
  let bufnrlist = tabpagebuflist(v:lnum)

  " Add '+' if one of the buffers in the tab page is modified
  for bufnr in bufnrlist
    if getbufvar(bufnr, "&modified")
      let label = '+'
      break
    endif
  endfor

  let label .= v:lnum
  let label .= ' '

  " Get active buffer details
  let active_bufnr = bufnrlist[tabpagewinnr(v:lnum) - 1]
  let project = getbufvar(active_bufnr, 'title', '')

  " Use project name if known, fallback to file name
  if !empty(project)
    let value = project
  else
    let file = bufname(active_bufnr)
    if empty(file)
      let value = 'No Name'
    else
      let value = fnamemodify(file, ':t')
    endif
  endif

  let label .= '[' . value . ']'

  " Append the number of windows in the tab page if more than one
  let wincount = tabpagewinnr(v:lnum, '$')
  if wincount > 1
    let label .= ' (' . wincount . ')'
  endif

  return label
endfunction

" Register autocommand to run after vim-project's VimEnter autocommand has run
augroup gvimrc_guitablabel
  autocmd!
  autocmd VimEnter * set guitablabel=%!GuiTabLabel()
augroup END

" Lightweight tab/file persistence: reopen the same files & tab layout next time,
" plus the GUI window's size (resize = lines/columns).
" Deliberately omit 'options'/'winsize' so we don't reassert stale settings or
" inner split sizes. Also no 'winpos': under Wayland the compositor owns window
" placement and ignores app position requests, so it would be dead weight here.
set sessionoptions=buffers,tabpages,curdir,resize
let g:session_file = expand('~/.vim/last-session.vim')

augroup gvimrc_autosession
  autocmd!
  " Save on quit
  autocmd VimLeavePre * execute 'mksession! ' . g:session_file
  " Restore only on a bare launch (no file args), if a session exists.
  " 'nested' lets the restored buffers fire the normal file-open autocmds
  " (syntax, cursor-restore, vim-project titles).
  autocmd VimEnter * nested if argc() == 0 && filereadable(g:session_file)
    \ | execute 'source ' . g:session_file | endif
augroup END

" Reload both configs in the running session (vimrc first, then gvimrc).
" Additive: redefines mappings but does not remove ones deleted from the files.
command! Reload source $MYVIMRC | source $MYGVIMRC
nnoremap <leader>rc :Reload<CR>

let s:gvimrc_after_local = expand($HOME . '/.gvimrc.after')
if filereadable(s:gvimrc_after_local)
  exec ':so ' . s:gvimrc_after_local
endif


