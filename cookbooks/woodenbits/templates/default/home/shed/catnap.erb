#!/usr/bin/env bash
set -euo pipefail

readonly UNIT="catnap@$(id -u).service"
readonly FREEZE_SETTLE_SECONDS=4
readonly TELEMETRY_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/catnap"
DRY_RUN=false

usage() {
    echo "Usage: catnap [--dry-run]"
}

parse-args() {
    case "${1:-}" in
        '') ;;
        --dry-run) DRY_RUN=true ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac

    if (( $# > 1 )); then
        usage >&2
        exit 2
    fi
}

capture-telemetry() {
    local readonly destination="$1"
    local readonly user_slice="user-$(id -u).slice"

    {
        printf 'Captured: '
        date --iso-8601=seconds
        printf 'User slice CPU usage (ns): '
        systemctl show "$user_slice" --property=CPUUsageNSec --value
        printf 'Battery energy (uWh): '
        cat /sys/class/power_supply/BAT*/energy_now 2>/dev/null || echo 'unavailable'
        printf '\n'
        perf-watch-cmd
    } > "$destination"
}

detect-nvidia-gpu() {
    local dev=''

    for dev in /sys/bus/pci/devices/*; do
        if [[ -f "$dev/vendor" && "$(cat "$dev/vendor")" == '0x10de' &&
              -f "$dev/class" && "$(cat "$dev/class")" =~ ^0x03 ]]; then
            echo "$dev"

            return 0
        fi
    done

    # Return 0 even if not found to prevent 'set -e' from aborting on non-NVIDIA systems
    return 0
}

print-summary() {
    local -n telemetry="$1"
    local readonly elapsed_seconds=$((telemetry[after_epoch] - telemetry[before_epoch]))

    local -r timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local summary="Finished ${elapsed_seconds}s catnap at ${timestamp}"
    local details=""

    if [[ "${telemetry[before_cpu]:-}" =~ ^[0-9]+$ && "${telemetry[after_cpu]:-}" =~ ^[0-9]+$ ]]; then
        details+=$(printf 'user CPU: %.3fs' "$((telemetry[after_cpu] - telemetry[before_cpu]))e-9")
    fi

    if [[ "${telemetry[before_battery_status]:-}" == 'Discharging' &&
          "${telemetry[after_battery_status]:-}" == 'Discharging' &&
          "${telemetry[before_energy]:-}" =~ ^[0-9]+$ && "${telemetry[after_energy]:-}" =~ ^[0-9]+$ &&
          "$elapsed_seconds" -gt 0 ]]; then
        local readonly battery_stats=$(awk \
            -v energy_uwh="$((telemetry[before_energy] - telemetry[after_energy]))" \
            -v seconds="$elapsed_seconds" \
            'BEGIN { printf "%.2fW (%.3fWh used)", (energy_uwh * 0.0036 / seconds), (energy_uwh / 1000000) }')
        if [[ -n "$details" ]]; then
            details+=", "
        fi
        details+="energy rate: ${battery_stats}"
    fi

    if [[ "${telemetry[before_nvidia_active]:-}" =~ ^[0-9]+$ && "${telemetry[after_nvidia_active]:-}" =~ ^[0-9]+$ &&
          "${telemetry[before_nvidia_suspended]:-}" =~ ^[0-9]+$ && "${telemetry[after_nvidia_suspended]:-}" =~ ^[0-9]+$ ]]; then
        local readonly active_diff=$((telemetry[after_nvidia_active] - telemetry[before_nvidia_active]))
        local readonly suspended_diff=$((telemetry[after_nvidia_suspended] - telemetry[before_nvidia_suspended]))
        local readonly total_diff=$((active_diff + suspended_diff))
        if (( total_diff > 0 )); then
            local readonly suspended_rate=$(awk \
                -v active="$active_diff" \
                -v suspended="$suspended_diff" \
                'BEGIN { printf "%.1f", (suspended * 100) / (active + suspended) }')
            if [[ -n "$details" ]]; then
                details+=", "
            fi
            details+="NVIDIA suspended rate: ${suspended_rate}%"
        fi
    fi

    if [[ -n "$details" ]]; then
        summary+=" (${details})"
    fi

    echo "$summary"
}

main() {
    declare -A stats=()
    local run_id before_file after_file
    local nvidia_active_file=''
    local nvidia_suspended_file=''

    parse-args "$@"

    if $DRY_RUN; then
        echo "[dry-run] Would save before/after telemetry under: ${TELEMETRY_DIR}"
        echo '[dry-run] Would run before and after catnap: perf-watch-cmd'
        echo '[dry-run] The Catnap watcher would power off the display and restore it on input.'
        echo '[dry-run] Would set CPU EPP to power'
        echo "[dry-run] Would run: systemctl start --no-block ${UNIT}"
        echo '[dry-run] Would restore CPU EPP on wake'

        return
    fi

    mkdir -p "$TELEMETRY_DIR"
    run_id=$(date '+%Y%m%d-%H%M%S')
    before_file="${TELEMETRY_DIR}/${run_id}-before.txt"
    after_file="${TELEMETRY_DIR}/${run_id}-after.txt"
    capture-telemetry "$before_file"
    stats[before_epoch]=$(date +%s)
    stats[before_cpu]=$(systemctl show "user-$(id -u).slice" --property=CPUUsageNSec --value)
    stats[before_energy]=$(cat /sys/class/power_supply/BAT*/energy_now 2>/dev/null || true)
    stats[before_battery_status]=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null || true)

    local -r nvidia_dev=$(detect-nvidia-gpu)

    if [[ -n "$nvidia_dev" ]]; then
        nvidia_active_file="${nvidia_dev}/power/runtime_active_time"
        nvidia_suspended_file="${nvidia_dev}/power/runtime_suspended_time"
    fi

    if [[ -f "$nvidia_active_file" && -f "$nvidia_suspended_file" ]]; then
        stats[before_nvidia_active]=$(cat "$nvidia_active_file")
        stats[before_nvidia_suspended]=$(cat "$nvidia_suspended_file")
    fi

    PREVIOUS_EPP=$(cpu-epp-show)

    trap 'exit 1' INT TERM HUP
    trap 'if [[ -n "${PREVIOUS_EPP:-}" ]]; then pkexec cpu-epp-set "$PREVIOUS_EPP" || true; fi' EXIT

    pkexec cpu-epp-set power

    # Polkit permits this user to start only their own catnap unit. Do not wait
    # for it: the unit powers off the display and freezes this user slice.
    systemctl start --no-block "${UNIT}" >/dev/null

    # Let the watcher freeze this slice before attempting the after snapshot.
    # This sleep resumes only after Catnap receives input and thaws the slice.
    sleep "$FREEZE_SETTLE_SECONDS"

    # Give the display/monitor time to physically power on and redraw before printing the summary
    sleep 1

    # Reset GNOME idle trackers to prevent immediate auto-suspend after wake-up
    busctl --user call org.gnome.ScreenSaver /org/gnome/ScreenSaver org.gnome.ScreenSaver SetActive b false >/dev/null 2>&1 || true
    busctl --user set-property org.gnome.SessionManager /org/gnome/SessionManager/Presence org.gnome.SessionManager.Presence status u 0 >/dev/null 2>&1 || true

    stats[after_epoch]=$(date +%s)
    stats[after_cpu]=$(systemctl show "user-$(id -u).slice" --property=CPUUsageNSec --value)
    stats[after_energy]=$(cat /sys/class/power_supply/BAT*/energy_now 2>/dev/null || true)
    stats[after_battery_status]=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null || true)

    if [[ -f "$nvidia_active_file" && -f "$nvidia_suspended_file" ]]; then
        stats[after_nvidia_active]=$(cat "$nvidia_active_file")
        stats[after_nvidia_suspended]=$(cat "$nvidia_suspended_file")
    fi

    capture-telemetry "$after_file"
    print-summary stats
}

main "$@"
