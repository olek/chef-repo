#!/usr/bin/env bash
set -e
set -o pipefail

usage() {
    echo "Usage: cpu-epp-show [--all|-a|--help|-h]"
    echo "Shows the CPU Energy Performance Preference (EPP) mode."
}

case "${1:-}" in
    '')
        cat /sys/devices/system/cpu/cpufreq/policy0/energy_performance_preference
        ;;
    --all|-a)
        for file in /sys/devices/system/cpu/cpufreq/policy{0..11}/energy_performance_preference; do
            echo -n "$file: "
            cat "$file"
        done
        ;;
    --help|-h)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
